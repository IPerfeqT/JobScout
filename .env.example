# "private" (home server, live scraping from the dashboard) or "demo" (public, cache-only, per-visitor sandbox)
JOBTOOL_MODE=private
JOBTOOL_DB_PATH=data/jobtool.db
# Result cache TTL per extension + filter hash
JOBTOOL_CACHE_TTL_MIN=60
# Background refresh of presets.json (0 disables; use `jobtool refresh` from cron instead)
JOBTOOL_REFRESH_INTERVAL_MIN=0
# Per-visitor rate limits (requests per minute)
JOBTOOL_RATE_LIMIT_READ=120
JOBTOOL_RATE_LIMIT_WRITE=30
# Only trust X-Forwarded-For when running behind your own reverse proxy
JOBTOOL_TRUST_PROXY=false
# Delete demo sandbox state for visitors inactive this many days
JOBTOOL_DEMO_SESSION_DAYS=7
# Extension breakage alerts (leave empty to only log)
DISCORD_WEBHOOK_URL=
JOBTOOL_USER_AGENT=JobAppToolBot/0.1 (personal job search tool)
